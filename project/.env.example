# ==============================================================================
# Real-Time Big Data News Analytics Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate your local values.
# Real credentials must NEVER be committed to version control.

# --- Supabase Database Configuration ---
# Required for PostgreSQL historical news accumulation & live count queries
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# --- External News Provider API Configurations (Optional) ---
# 1. GDELT DOC API v2 (Broad news discovery - Public, no API key required)
VITE_GDELT_API_URL=https://api.gdeltproject.org/api/v2/doc/doc

# 2. GNews API (Optional structured JSON provider - Register at https://gnews.io)
# Note: Free tier provides 100 requests/day with 12-hour delayed feed
VITE_GNEWS_API_KEY=your_gnews_api_key_here

# 3. The Guardian Open Platform (Optional - Register at https://open-platform.theguardian.com)
VITE_GUARDIAN_API_KEY=your_guardian_developer_api_key

# --- Pipeline Engine Settings ---
# Ingestion polling interval in seconds (Default: 300 seconds = 5 minutes)
VITE_POLL_INTERVAL_SECONDS=300
VITE_VOLUME_BATCH_SIZE=1000
VITE_FRESHNESS_THRESHOLD_MINUTES=60
